{
  "compilerOptions": {
    // File Layout
    // Adjusted rootDir to include generated files outside src (e.g. prisma generated files)
    "rootDir": "./",
    "outDir": "./dist",
    "module": "esnext",
    "target": "es6",
    "types": ["node"],
    "lib": ["esnext"],
    "esModuleInterop": true,
    "emitDeclarationOnly": false,
    "strictNullChecks": true
  },
  "exclude": [
    "node_modules",
    "generated",
    "prisma"
  ]
}
